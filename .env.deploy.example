# Copy to .env.deploy.local (git-ignored) to run `pnpm deploy:ftp` from this
# machine. The GitHub Deploy workflow never reads it: it uses the repository
# secrets and the UMAMI_WEBSITE_ID variable instead.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# Must end with a slash: / when the FTP account is limited to the site folder.
FTP_DIR=/
# Umami Cloud website id. Empty = pages published without analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

Options -MultiViews
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?shellvia\.fr$ [NC]
RewriteRule ^(.*)$ https://shellvia.com/fr/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?shellvia\.app$ [NC]
RewriteRule ^(.*)$ https://shellvia.com/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.shellvia\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://shellvia.com/$1 [R=301,L]
ErrorDocument 404 /404.html
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; connect-src 'self' https://api.github.com https://cloud.umami.is https://api-gateway.umami.dev; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
